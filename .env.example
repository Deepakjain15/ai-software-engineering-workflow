# Optional. If unset, ai-dev runs in offline demo mode using recorded
# fixtures in fixtures/*.json instead of calling a real model.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-5.
AI_DEV_MODEL=

# Optional. Only used to print an estimated $ cost alongside token counts.
AI_DEV_INPUT_PRICE_PER_MTOK=
AI_DEV_OUTPUT_PRICE_PER_MTOK=
